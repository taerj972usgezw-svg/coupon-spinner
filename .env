# ══════════════════════════════════════════
#  쿠폰 돌림판 - 서버 환경 설정
# ══════════════════════════════════════════

# 서버 포트 (80 = 기본 HTTP, 관리자 권한 필요)
PORT=80

# 서버 호스트 (0.0.0.0 = 모든 IP에서 접속 허용)
HOST=0.0.0.0

# 도메인
DOMAIN=www.쿠폰.온라인.한국

# 환경 (production / development)
NODE_ENV=production

# 로그 레벨 (error, warn, info, debug)
LOG_LEVEL=info

# 디스코드 웹훅 URL
